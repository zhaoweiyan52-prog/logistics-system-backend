    {
      "name": "Create Parcel",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Create parcel success and get order no\", function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code, jsonData.message).to.eql(0);",
              "    pm.expect(jsonData.data.no).to.match(/^SF[0-9]{8}[A-F0-9]{32}$/);",
              "    pm.environment.set(\"orderNo\", jsonData.data.no);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"receiver\": \"Bob\",\n    \"dest\": \"HKMU\",\n    \"goods\": \"books\",\n    \"weight\": 1.2,\n    \"fee\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Track Parcel",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Tracking variable matches the newly created order\", function () {",
              "    pm.expect(pm.environment.get(\"orderNo\"), \"Run Create Parcel successfully first\").to.match(/^SF[0-9]{8}[A-F0-9]{32}$/);",
              "    pm.expect(pm.variables.get(\"orderNo\"), \"Another scope overrides the environment orderNo\").to.eql(pm.environment.get(\"orderNo\"));",
              "});",
              "pm.test(\"Get the requested parcel and its tracking history\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code, jsonData.message).to.eql(0);",
              "    pm.expect(jsonData.data.no).to.eql(pm.environment.get(\"orderNo\"));",
              "    pm.expect(jsonData.data.traces).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderNo}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderNo}}"
          ]
        },
        "description": "Uses data.no saved by Create Parcel, with the same customer token. If B03 occurs, record the resolved request URL and the matching history entry without exporting credentials."
      },
      "response": []
    },
